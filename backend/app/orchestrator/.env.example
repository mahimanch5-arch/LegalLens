# Intent Classifier Configuration

# Claude API key for Haiku model (intent classification)
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# LLM configuration for intent classification
# Model: claude-haiku-4-5 (fast, cost-effective for classification)
INTENT_CLASSIFIER_MODEL=claude-haiku-4-5

# Confidence threshold for heuristic-based classification
# If below this, fallback to LLM (0.0 - 1.0)
INTENT_CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# Temperature for LLM classification (affects randomness, 0.0-2.0)
# Lower = more deterministic (recommended for classification)
INTENT_CLASSIFIER_TEMPERATURE=0.2

# Enable debug logging for intent classification
INTENT_CLASSIFIER_DEBUG=false
