# Copy to .env and adjust. Every setting is optional in dev; see app/core/config.py for the full list.

# dev | test | prod. The /api/dev endpoints exist only in dev and test.
LL_ENV=dev

# SQLite database, encrypted blobs and (in dev) the generated blob key live here.
LL_DATA_DIR=./data

# The single v1 user (FR-27). Created or updated at startup.
LL_USER_EMAIL=dana@whitfieldlaw.com
LL_USER_PASSWORD=legallens
LL_USER_NAME=Dana Whitfield

# Fernet key for files at rest. Required outside dev/test. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LL_ENCRYPTION_KEY=

# Only needed if the frontend is served from a different origin (the Vite proxy makes this unnecessary).
# LL_CORS_ORIGINS=["http://localhost:5173"]

# Stub orchestrator streaming speed, ms per token.
LL_STUB_TOKEN_DELAY_MS=22

# >0 slows ingestion status transitions so the Library's progress pills are visible in a demo.
LL_INGEST_STAGE_DELAY_MS=0
